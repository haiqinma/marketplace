{
  "timezone": "Asia/Shanghai",
  "deploy_root": "deploy",
  "modules_file": "modules.conf",
  "error_log_name": "logs/error.log",
  "state_db": "runtime/state.db",
  "results_dir": "runtime/results",
  "work_dir": "runtime/work",
  "lock_file": "runtime/yeying-ops.lock",
  "codex_command": "codex",
  "sandbox": "read-only",
  "ignore_user_config": true,
  "model_provider": "openai",
  "model": "",
  "daily_groups": 20,
  "samples_per_group": 3,
  "sample_chars": 4000,
  "total_chars": 60000,
  "timeout_seconds": 300,
  "retry_after_seconds": 3600,
  "include_undated_lines": true,
  "project": {
    "enabled": false,
    "required": false,
    "project_id": 8,
    "audit_column": 13,
    "audit_owner_id": 1,
    "allowed_auditor_ids": [1],
    "remediation_column": 13,
    "remediation_owner_id": 1,
    "maximum_severity": "P3",
    "categories": ["confirmed", "likely", "unknown"],
    "config": "~/.yeying/skills/project/config.toml"
  }
}
